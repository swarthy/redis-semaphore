{
  "name": "redis-semaphore",
  "version": "6.0.0",
  "description": "Distributed mutex and semaphore based on Redis",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware .",
    "test": "vitest run",
    "test-ci-with-coverage": "vitest run --coverage && cat coverage/lcov.info | coveralls",
    "coverage-html": "vitest run --coverage",
    "converalls": "vitest run --coverage && cat coverage/lcov.info | coveralls",
    "dev": "vitest",
    "build": "rm -rf lib && yarn tsc -b tsconfig.build.json",
    "preversion": "yarn lint && yarn test && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:swarthy/redis-semaphore.git"
  },
  "keywords": [
    "redis",
    "redlock",
    "mutex",
    "semaphore"
  ],
  "author": "Alexander Mochalin (horroshow@mail.ru)",
  "license": "MIT",
  "devDependencies": {
    "@swarthy/wait-for": "^2.1.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/debug": "^4.1.13",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "22.20.2",
    "@types/sinon": "^22.0.0",
    "@types/sinon-chai": "^4.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "benchmark": "^2.1.4",
    "chai": "6.2.2",
    "chai-as-promised": "8.0.2",
    "coveralls": "^3.1.1",
    "ioredis": "6.0.0",
    "ioredis-mock": "8.13.1",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "sinon": "22.1.0",
    "sinon-chai": "4.0.1",
    "snyk": "1.1307.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "ioredis": "^4.1.0 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "resolutions": {
    "ioredis": "6.0.0"
  },
  "packageManager": "yarn@4.1.0+sha256.81a00df816059803e6b5148acf03ce313cad36b7f6e5af6efa040a15981a6ffb",
  "files": [
    "lib/"
  ]
}
